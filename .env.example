# Copy this file to ".env.local" and fill it in. ".env.local" is private and is never committed.
#
# The mail account that SENDS the RSVP emails. For Gmail, SMTP_PASS must be an
# "App password" (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_USER=you@gmail.com
SMTP_PASS=

# Where RSVPs are delivered. Leave empty to send them to SMTP_USER itself.
CONTACT_EMAIL=

# The website address, shown in the email footer (optional).
NEXT_PUBLIC_SITE_URL=

# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 587), RSVP_FROM, PORT (default 3000)
# RSVP_DRY_RUN=1   # test mode: print the email in the terminal instead of sending it
